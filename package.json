{
  "name": "privoo-browser",
  "version": "6.0.4",
  "description": "Privacy focused browser built on Chromium.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --privoo-profile=dev --privoo-skip-picker",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:all": "electron-builder -mwl --publish never"
  },
  "author": "Privoo <dev@privoo.app>",
  "license": "MIT",
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v42.3.3+wvcus",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.5.2",
    "electron-updater": "^6.3.9",
    "mlkem": "^2.7.0"
  },
  "build": {
    "appId": "com.privoo.browser",
    "productName": "Privoo",
    "electronDist": "node_modules/electron/dist",
    "protocols": [
      {
        "name": "Web Protocol",
        "schemes": [
          "http",
          "https",
          "mailto"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "role": "Viewer",
        "mimeType": "text/html"
      },
      {
        "ext": "htm",
        "name": "HTML Document",
        "role": "Viewer",
        "mimeType": "text/html"
      },
      {
        "ext": "xhtml",
        "name": "XHTML Document",
        "role": "Viewer",
        "mimeType": "application/xhtml+xml"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": "svg",
        "name": "SVG Image",
        "role": "Viewer",
        "mimeType": "image/svg+xml"
      },
      {
        "ext": "webp",
        "name": "WebP Image",
        "role": "Viewer",
        "mimeType": "image/webp"
      }
    ],
    "extraResources": [
      {
        "from": "logo.png",
        "to": "logo.png"
      },
      {
        "from": "wallpaper.png",
        "to": "wallpaper.png"
      },
      {
        "from": "privoovpn.png",
        "to": "privoovpn.png"
      },
      {
        "from": "privoovpnbanner.png",
        "to": "privoovpnbanner.png"
      },
      {
        "from": "privoomediadownloader.png",
        "to": "privoomediadownloader.png"
      },
      {
        "from": "privooshield.png",
        "to": "privooshield.png"
      },
      {
        "from": "logo.ico",
        "to": "logo.ico"
      }
    ],
    "files": [
      "main.js",
      "google-spoof.js",
      "google-auth.js",
      "password-store.js",
      "password-autofill.js",
      "identity-autofill.js",
      "identities-store.js",
      "file-picker-recent.js",
      "mariana.js",
      "preload.js",
      "webview-preload.js",
      "oauth-preload.js",
      "mobile-frame-preload.js",
      "profile-store.js",
      "profile-picker-preload.js",
      "discord-rpc.js",
      "settings-store.js",
      "history-store.js",
      "download-store.js",
      "session-store.js",
      "browser-import.js",
      "blocklist.js",
      "safety.js",
      "ai.js",
      "ytdlp.js",
      "ytdlp-installer.js",
      "bin/**/*",
      "renderer/**/*",
      "logo.png",
      "logo.ico"
    ],
    "win": {
      "icon": "logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Privoo",
      "artifactName": "Privoo-Setup-${version}.${ext}",
      "include": "installer.nsh"
    },
    "mac": {
      "icon": "logo.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "logo.png",
      "category": "Network",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "sharp4real",
      "repo": "privoobrowser"
    },
    "afterSign": "afterSign-vmp.js"
  }
}
